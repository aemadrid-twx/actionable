# frozen_string_literal: true

# OpenTelemetry for spec/actionable/otel/tracing_spec.rb (the `otel` job in
# .github/workflows/main.yml). The default suite skips that spec: neither gem
# is in the main Gemfile, and actionable-rb does not depend on either
# (`opentelemetry-api` is a soft dependency of `require 'actionable/otel'`).
# The SDK is test-only, for its in-memory span exporter.
#
#   BUNDLE_GEMFILE=gemfiles/otel.gemfile bundle install
#   BUNDLE_GEMFILE=gemfiles/otel.gemfile bundle exec rspec
eval_gemfile '../Gemfile'

gem 'opentelemetry-api', '~> 1.11', require: false
gem 'opentelemetry-sdk', '~> 1.13', require: false
